# Opsional: salin ke backend/.env. Backend lokal berjalan tanpa file ini.
PORT=5000
HOST=127.0.0.1
FRONTEND_URL=http://localhost:5173

# Lokal: backend/data/tutorin.json. Isi DATABASE_URL untuk memakai PostgreSQL/Neon.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# DATA_FILE=C:/path/to/tutorin.json

# Jika tidak disetel, secret acak dibuat dan disimpan bersama database lokal.
# JWT_SECRET=isi_dengan_secret_acak_panjang
